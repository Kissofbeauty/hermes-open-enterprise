#!/usr/bin/env bash
# ohermes — manage Hermes Open Enterprise employees.
# Everything it does can be done by hand: see guides/admin.md.
set -euo pipefail
export MSYS_NO_PATHCONV=1   # Git Bash on Windows: don't rewrite /paths

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
COMPOSE_FILE_MAIN="$ROOT/docker-compose.yml"
OVERRIDE="$ROOT/docker-compose.override.yml"   # generated: the employees (see write_override)
USERS="$ROOT/Users"
ARCHIVE="$ROOT/Archive"
TEMPLATE="$USERS/_template"
DEPTS="$ROOT/Organization-Knowledge/Organization/Department"
CONF="$ROOT/Config/ohermes.conf"           # website rules (admins only; never mounted into an agent)
LEGACY_CONF="$ROOT/ohermes.conf"           # before v0.7 — still read for one release (see conf_fallback)
ORG_SUB=(Skills KPI Knowledge)            # folders of a department's Assign/ and of each employee
ARCHIVED_ORG="Organization-Knowledge"     # the employee's personal folder inside Archive/<name>_<date>/
RESERVED_NAMES=" assign caddy cloudflared ops egress edge outbound "

# ---------------------------------------------------------------- helpers
if [[ -t 1 ]]; then B=$'\e[1m'; Y=$'\e[33m'; G=$'\e[32m'; R=$'\e[31m'; N=$'\e[0m'; else B='' Y='' G='' R='' N=''; fi
info() { printf '%s\n' "$*"; }
ok()   { printf '%s✓%s %s\n' "$G" "$N" "$*"; }
warn() { printf '%s⚠%s  %s\n' "$Y" "$N" "$*" >&2; }
die()  { printf '%s✗%s %s\n' "$R" "$N" "$*" >&2; exit 1; }
lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

# Path as the docker CLI expects it (Windows dev machines: C:/...)
DROOT="$ROOT"; command -v cygpath >/dev/null 2>&1 && DROOT="$(cygpath -m "$ROOT")"
dpath() { if command -v cygpath >/dev/null 2>&1; then cygpath -m "$1"; else printf '%s' "$1"; fi; }
dc() { [[ -f "$OVERRIDE" ]] || write_override; docker compose --project-directory "$DROOT" -f "$DROOT/docker-compose.yml" -f "$DROOT/docker-compose.override.yml" "$@"; }
project_name() { awk '/^name:/ {print $2; exit}' "$COMPOSE_FILE_MAIN"; }

load_env() {
  [[ -f "$ROOT/.env" ]] || die "missing $ROOT/.env — run: cp .env.example .env"
  # read only the keys we need, without executing the file
  local k
  for k in STAGE HERMES_DOMAIN PUBLIC_SCHEME PUBLIC_PORT_SUFFIX HERMES_IMAGE EGRESS_IMAGE AI_PROVIDER_HOSTS AI_PROVIDER AI_MODEL AI_BASE_URL AI_API_KEY DEFAULT_CPUS DEFAULT_MEMORY NETWORK_PREFIX; do
    printf -v "$k" '%s' "$(env_get "$ROOT/.env" "$k")"
  done
  : "${HERMES_DOMAIN:=localhost}" "${PUBLIC_SCHEME:=https}" "${HERMES_IMAGE:=nousresearch/hermes-agent:v0.22.2@sha256:36099926da316742423544e055d4734777105ffe6341873af5459b957d0c2919}"
  : "${EGRESS_IMAGE:=ubuntu/squid:6.6-24.04_edge@sha256:8a3baed477e2c282ab8aa5edad442f69873246964f225c5c2ae8364b6610963c}"
  : "${DEFAULT_CPUS:=2}" "${DEFAULT_MEMORY:=4g}" "${NETWORK_PREFIX:=10.213}"
  [[ "$NETWORK_PREFIX" =~ ^[0-9]{1,3}\.[0-9]{1,3}$ ]] || die ".env: NETWORK_PREFIX must look like 10.213"
}

env_get() { # <file> <KEY> → value (quotes stripped)
  local v
  v="$(grep -E "^$2=" "$1" 2>/dev/null | tail -n1 | cut -d= -f2-)" || true
  v="${v%$'\r'}"
  if [[ "$v" == \'*\' ]]; then v="${v:1:${#v}-2}"; elif [[ "$v" == \"*\" ]]; then v="${v:1:${#v}-2}"; fi
  printf '%s' "$v"
}

sq() { printf "'%s'" "${1//\'/}"; }   # single-quote a value for .env (quotes removed)

env_set() { # <file> <KEY> <value> — replace the line if present, otherwise append it
  local tmp; tmp="$(mktemp)"
  if grep -qE "^$2=" "$1"; then
    OH_LINE="$2=$(sq "$3")" OH_KEY="$2" awk 'index($0, ENVIRON["OH_KEY"] "=") == 1 { print ENVIRON["OH_LINE"]; next } { print }' "$1" > "$tmp"
  else
    { cat "$1"; printf '%s=%s\n' "$2" "$(sq "$3")"; } > "$tmp"
  fi
  cat "$tmp" > "$1"; rm -f "$tmp"; chmod 600 "$1"
}

require_admin() {
  if [[ "$(uname -s)" == Linux && $EUID -ne 0 ]]; then
    die "run with sudo (employee secrets are root-only files)"
  fi
}

# ---------------------------------------------------------------- names & validation
# email (John.Doe@example.com) → server name (john-doe): local part, lowercase,
# every character other than a-z 0-9 → "-". Set once at create; never changes.
name_from_email() { lower "${1%@*}" | LC_ALL=C sed 's/[^a-z0-9]/-/g'; }

# any reference (server name, old dotted username, email local part) → server-name form
norm_name() { lower "$1" | LC_ALL=C sed 's/[^a-z0-9]/-/g'; }

validate_name() {
  [[ "$1" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ && ${#1} -le 40 ]] \
    || die "server name '$1' (from the email) is not usable — it must be a-z 0-9 with single '-' between parts, max 40. Choose the employee's name yourself and use a matching email."
  [[ "$RESERVED_NAMES" != *" $1 "* ]] || die "server name '$1' is reserved — use another email"
}
validate_email() {
  [[ "$1" =~ ^[a-z0-9._%+-]+@[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$ && ${#1} -le 254 ]] \
    || die "invalid email '$1'"
}
validate_subdomain() {
  [[ "$1" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]] \
    || die "invalid subdomain '$1' — a-z 0-9 and -, 1-63 characters, not starting or ending with -"
}
validate_text() { # <label> <value>
  [[ -z "$2" || "$2" =~ ^[[:alnum:][:space:]._\&/()+-]{1,60}$ ]] || die "invalid $1 '$2' (letters, digits, spaces and . _ & / ( ) + - , max 60)"
}
valid_dept_name() { [[ "$1" =~ ^[A-Za-z][A-Za-z0-9-]{0,39}$ ]]; }

# -d value → department folder name: case-insensitive match to an existing department,
# otherwise first letter upper-cased (sales → Sales); empty → General.
dept_exists() { # <Dept> — case-insensitive
  local d
  for d in "$DEPTS"/*/; do [[ -d "$d" && "$(lower "$(basename "$d")")" == "$(lower "$1")" ]] && return 0; done
  return 1
}
resolve_department() {
  local want="${1:-General}" d base
  valid_dept_name "$want" || die "invalid department '$want' — a letter first, then letters, digits or - (max 40), e.g. Sales, IT, Customer-service"
  [[ "$(lower "$want")" == assign ]] && die "'Assign' cannot be a department name"
  for d in "$DEPTS"/*/; do
    [[ -d "$d" ]] || continue
    base="$(basename "$d")"
    if [[ "$(lower "$base")" == "$(lower "$want")" ]]; then printf '%s' "$base"; return 0; fi
  done
  printf '%s%s' "$(printf '%s' "${want:0:1}" | tr '[:lower:]' '[:upper:]')" "${want:1}"
}

ensure_department() { # <Dept> — Department/<Dept>/Assign/{Skills,KPI,Knowledge}
  local s
  for s in "${ORG_SUB[@]}"; do mkdir -p "$DEPTS/$1/Assign/$s"; done
}
ensure_person_dirs() { # <dir> — personal KPI/Knowledge/Skills: root only on the server (0700);
  local s                # the container mounts the sub-folders directly, so it still reads them
  for s in "${ORG_SUB[@]}"; do mkdir -p "$1/$s"; done
  chmod 700 "$1" 2>/dev/null || true
}

# Archive/<name>_<date>[-n]/ → <name>
archive_name() { local b; b="$(basename "$1")"; printf '%s' "${b%_*}"; }

# Every employee folder: active (Users/*) and archived (Archive/*)
each_employee_env() { local f; for f in "$USERS"/*/.env "$ARCHIVE"/*/.env; do [[ -f "$f" ]] && [[ "$f" != "$TEMPLATE/.env" ]] && printf '%s\n' "$f"; done; return 0; }

where_of() { # <.env path> → "Users/x" or "Archive/x_date"
  local d; d="$(dirname "$1")"; printf '%s' "${d#"$ROOT"/}"
}

name_taken() { # <name> → prints where it is used, case-insensitive (Users, Archive, Department folders)
  local n; n="$(lower "$1")"
  local d dirs=("$USERS"/*/ "$ARCHIVE"/*/)
  # manage_folders = off: a personal folder may be prepared in the knowledge repository before `create`
  org_off_quiet || dirs+=("$DEPTS"/*/*/)
  for d in "${dirs[@]}"; do
    [[ -d "$d" ]] || continue
    local b; b="$(basename "$d")"
    case "$d" in
      "$ARCHIVE"/*) b="$(archive_name "$d")" ;;
      "$DEPTS"/*) [[ "$b" == Assign ]] && continue ;;
    esac
    d="${d%/}"; if [[ "$(lower "$b")" == "$n" ]]; then printf '%s' "${d#"$ROOT"/}"; return 0; fi
  done
  local f
  while IFS= read -r f; do
    if [[ "$(norm_name "$(env_get "$f" EMP_USERNAME)")" == "$n" ]]; then where_of "$f"; return 0; fi
  done < <(each_employee_env)
  return 1
}

email_owner() { # <email> [<except name>] → prints where it is used
  local f e
  while IFS= read -r f; do
    [[ -n "${2:-}" && "$f" == "$USERS/$2/.env" ]] && continue
    e="$(lower "$(env_get "$f" EMP_EMAIL)")"
    if [[ -n "$e" && "$e" == "$1" ]]; then where_of "$f"; return 0; fi
  done < <(each_employee_env)
  return 1
}

subdomain_of_env() { # <.env> → EMP_SUBDOMAIN (older archives: EMP_SLUG)
  local s; s="$(env_get "$1" EMP_SUBDOMAIN)"; [[ -n "$s" ]] || s="$(env_get "$1" EMP_SLUG)"; printf '%s' "$s"
}
subdomain_owner() { # <subdomain> [<except name>] → prints where it is used
  local f
  while IFS= read -r f; do
    [[ -n "${2:-}" && "$f" == "$USERS/$2/.env" ]] && continue
    if [[ "$(lower "$(subdomain_of_env "$f")")" == "$1" ]]; then where_of "$f"; return 0; fi
  done < <(each_employee_env)
  return 1
}

# -u <server name or email> → NAME (server name). <scope>: active | archived
resolve_user() { # <ref> <scope>
  local ref; ref="$(lower "$1")"
  NAME=""
  if [[ "$ref" == *@* ]]; then
    local f
    while IFS= read -r f; do
      [[ "$(lower "$(env_get "$f" EMP_EMAIL)")" == "$ref" ]] || continue
      case "$f" in
        "$USERS"/*)   [[ "$2" == active ]]   && NAME="$(basename "$(dirname "$f")")" ;;
        "$ARCHIVE"/*) [[ "$2" == archived ]] && NAME="$(archive_name "$(dirname "$f")")" ;;
      esac
      [[ -n "$NAME" ]] && break
    done < <(each_employee_env)
    [[ -n "$NAME" ]] || NAME="$(name_from_email "$ref")"   # not found by email: try the derived name
  else
    NAME="$(norm_name "$ref")"
  fi
  [[ "$NAME" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || die "invalid employee '$1'"
}

# ---------------------------------------------------------------- prompts
confirm() { # <question> → 0 if yes (default yes)
  local a
  read -rp "$1 [Y/n] " a || true
  [[ -z "$a" || "$a" =~ ^[Yy]$ ]]
}

read_masked() { # <prompt> <varname> — shows * per character, Backspace works
  local v="" c
  if [[ ! -t 0 ]]; then   # piped input (scripts/tests): one line, nothing echoed
    IFS= read -r v || true
    printf -v "$2" '%s' "$v"; return 0
  fi
  printf '%s' "$1" >&2
  while IFS= read -rsn1 c; do
    if [[ -z "$c" ]]; then break                                   # Enter
    elif [[ "$c" == $'\x7f' || "$c" == $'\b' ]]; then              # Backspace
      if [[ -n "$v" ]]; then v="${v%?}"; printf '\b \b' >&2; fi
    elif [[ "$c" == [[:cntrl:]] ]]; then :                         # ignore other control keys
    else v+="$c"; printf '*' >&2
    fi
  done
  printf '\n' >&2
  printf -v "$2" '%s' "$v"
}

ask_password() { # <who> → PASSWORD
  local p2
  read_masked "Password for $1 (min 12 characters): " PASSWORD
  read_masked "Repeat password: " p2
  [[ "$PASSWORD" == "$p2" ]] || die "passwords do not match"
}

check_password() {
  (( ${#1} >= 12 )) || die "password must be at least 12 characters"
  [[ "$1" != *"'"* ]] || die "password must not contain a single quote (')"
}

hash_password() { # stdin password → scrypt hash (Hermes' own implementation)
  docker run --rm -i --network none --entrypoint python3 "$HERMES_IMAGE" -c \
    'import sys; sys.path.insert(0, "/opt/hermes"); from plugins.dashboard_auth.basic import hash_password; print(hash_password(sys.stdin.read()))'
}

random_hex() { docker run --rm --network none --entrypoint python3 "$HERMES_IMAGE" -c 'import secrets; print(secrets.token_hex(32))'; }

# Next free network id — never reuses ids of active or archived employees.
next_net_id() {
  local max=0 id f
  for f in "$USERS"/*/.env "$ARCHIVE"/*/.env; do
    [[ -f "$f" ]] || continue
    id="$(env_get "$f" EMP_NET_ID)"
    [[ "$id" =~ ^[0-9]+$ ]] && (( id > max )) && max=$id
  done
  (( max + 1 <= 4095 )) || die "network id space exhausted"
  echo $(( max + 1 ))
}
subnet_of() { echo "$NETWORK_PREFIX.$(( $1 / 16 )).$(( ($1 % 16) * 16 ))/28"; }

# ---------------------------------------------------------------- docker-compose.override.yml (generated)
# docker-compose.yml is never edited: the employees live in docker-compose.override.yml, which
# Docker Compose reads automatically when it exists (and ignores when it doesn't). It is rebuilt
# from the folders in Users/ (every folder with compose.yml + .env, except _template), so it can
# never drift; it is git-ignored, so a server checkout stays clean for git-pull deploys.
active_names() { local d n; for d in "$USERS"/*/; do n="$(basename "$d")"; [[ "$n" == _* ]] && continue; [[ -f "$d/compose.yml" && -f "$d/.env" ]] && printf '%s\n' "$n"; done; return 0; }

write_override() {
  local tmp n names
  names="$(active_names)"
  tmp="$(mktemp)"
  {
    printf '# GENERATED by ohermes from Users/*/ — do not edit, never commit (rebuild: ./ohermes sync)\n'
    printf '# Docker Compose merges this file into docker-compose.yml automatically.\n'
    if [[ -z "$names" ]]; then printf 'services: {}\n'
    else
      printf 'include:\n'; while IFS= read -r n; do printf '  - Users/%s/compose.yml\n' "$n"; done <<<"$names"
      printf 'services:\n'
      printf '  caddy:\n    networks:\n';  while IFS= read -r n; do printf '      %s: {}\n' "$n"; done <<<"$names"
      printf '  egress:\n    networks:\n'; while IFS= read -r n; do printf '      %s: {}\n' "$n"; done <<<"$names"
    fi
  } > "$tmp"
  cat "$tmp" > "$OVERRIDE"; rm -f "$tmp"
  write_routes
}

# ---------------------------------------------------------------- Caddy routes (generated)
# Infrastructure/caddy/generated/routes.caddy: one exact host per active employee,
#   <EMP_SUBDOMAIN>.{$HERMES_DOMAIN} → <name>.employee.internal:9119
# Caddy serves nothing else (security review R5-01). Rebuilt with the override file; applied with
# caddy_reload (graceful: Caddy checks the new config first and keeps the old one on error).
ROUTES="$ROOT/Infrastructure/caddy/generated/routes.caddy"
write_routes() {
  local tmp n sub seen=" "
  mkdir -p "$(dirname "$ROUTES")"
  tmp="$(mktemp)"
  {
    printf '# GENERATED by ohermes from Users/*/.env (EMP_SUBDOMAIN) — do not edit, never commit\n'
    printf '# Rebuild: ./ohermes sync   (apply: docker compose exec caddy caddy reload --config /etc/caddy/Caddyfile)\n'
    while IFS= read -r n; do
      [[ -n "$n" ]] || continue
      sub="$(subdomain_of_env "$USERS/$n/.env")"
      if [[ ! "$sub" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]]; then
        warn "Users/$n/.env: EMP_SUBDOMAIN '$sub' is not valid — $n gets no web route"; continue
      fi
      if [[ "$seen" == *" $sub "* ]]; then
        warn "subdomain '$sub' is used twice — $n gets no web route (fix Users/$n/.env)"; continue
      fi
      seen+="$sub "
      printf '\n@emp_%s host %s.{$HERMES_DOMAIN:localhost}\nhandle @emp_%s {\n\timport hermes-route %s.employee.internal\n}\n' \
        "$n" "$sub" "$n" "$n"
    done < <(active_names)
  } > "$tmp"
  cat "$tmp" > "$ROUTES"; rm -f "$tmp"
  chmod 644 "$ROUTES" 2>/dev/null || true
}

caddy_running() { dc ps --status running --services 2>/dev/null | grep -qx caddy; }

# apply generated/routes.caddy to a running Caddy (no restart; old config kept on error)
caddy_reload() {
  caddy_running || return 0
  dc exec -T caddy caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile >/dev/null 2>&1 \
    || { warn "Caddy did not accept the new routes — it keeps the previous ones (see: docker compose logs caddy)"; return 1; }
}

# Files an employee folder needs before `docker compose up` (bind-mount sources):
# runtime/ is written by setup.py inside the container (root), model/ by `ohermes model`.
# Modes (Linux): Users/ and Users/<name>/ 0700 — only root on the server reads the AI key, chats
# and memory (bind mounts do not need the parent folders to be readable by the container user).
SHELL_RC_FILES=(.profile .bash_profile .bash_login .bashrc .bash_logout .inputrc)   # mounted from runtime/shell-rc
ensure_runtime() { # <name>
  local d="$USERS/$1" f
  mkdir -p "$d/runtime/hooks" "$d/runtime/empty" "$d/model" "$d/data"
  for f in config.yaml hermes.env auth.json SOUL.md active_profile shell-rc models_dev_cache.json models_dev_cache.etag; do
    [[ -d "$d/runtime/$f" ]] && rmdir "$d/runtime/$f" 2>/dev/null   # left by an old `docker compose up`
    [[ -f "$d/runtime/$f" ]] || ( umask 077; : > "$d/runtime/$f" )
  done
  # the shell start files in data/ become read-only mount points: a folder or symlink the agent
  # left there would stop the container from starting — move it aside (nothing is deleted)
  for f in "${SHELL_RC_FILES[@]}" models_dev_cache.json models_dev_cache.etag; do
    if [[ -L "$d/data/$f" || ( -e "$d/data/$f" && ! -f "$d/data/$f" ) ]]; then
      mv "$d/data/$f" "$d/data/$f.quarantined-$(date +%Y%m%d%H%M%S)" \
        && warn "Users/$1/data/$f was not a plain file — moved aside"
    fi
  done
  chmod 700 "$USERS" "$d" "$d/model" 2>/dev/null || true
  chmod 600 "$d/.env" "$d/model/model.yaml" "$d/model/model.env" 2>/dev/null || true
}

register()   { ensure_runtime "$1"; write_override; }
unregister() { write_override; }

user_url() { echo "${PUBLIC_SCHEME}://$1.${HERMES_DOMAIN}${PUBLIC_PORT_SUFFIX}"; }

# ---------------------------------------------------------------- Config/ohermes.conf
# One-release fallback: a checkout that still has ./ohermes.conf (and no Config/ohermes.conf) keeps
# working with a warning; `ohermes sync` moves the file (deploy.sh runs sync).
conf_fallback() {
  if [[ -f "$LEGACY_CONF" && ! -f "$CONF" ]]; then
    warn "ohermes.conf has moved to Config/ohermes.conf — using ./ohermes.conf for now (run: ohermes sync)"
    CONF="$LEGACY_CONF"
  elif [[ -f "$LEGACY_CONF" ]]; then
    warn "./ohermes.conf is ignored — the website rules are in Config/ohermes.conf (remove ./ohermes.conf)"
  fi
  return 0
}
move_legacy_conf() {
  if [[ -f "$LEGACY_CONF" && ! -f "$ROOT/Config/ohermes.conf" ]]; then
    mv "$LEGACY_CONF" "$ROOT/Config/ohermes.conf"
    CONF="$ROOT/Config/ohermes.conf"
    ok "moved ./ohermes.conf → Config/ohermes.conf"
  fi
  conf_fallback
}

# ---------------------------------------------------------------- [organization-knowledge] manage_folders
# on  (default) = ohermes creates / moves / archives department and employee folders in Organization-Knowledge
# off           = Organization-Knowledge is managed elsewhere (e.g. its own git repository): ohermes never
#                 creates, moves, removes or chmods anything in it — it only warns which folders are missing.
bool_word() { # <word> → prints on | off, returns 1 when it is neither
  case "$(lower "$1")" in
    on|true|yes)  printf on ;;
    off|false|no) printf off ;;
    *) return 1 ;;
  esac
}

# conf_value <file> <section> <key> → raw value of "key = value" in [section] (last one wins; empty if missing)
conf_value() {
  [[ -f "$1" ]] || return 0
  awk -v want="[$2]" -v key="$3" '
    { sub(/\r$/, ""); s = $0; gsub(/^[ \t]+|[ \t]+$/, "", s) }
    s == "" || s ~ /^#/ { next }
    s ~ /^\[/ { insec = (s == want); next }
    insec {
      i = index(s, "="); if (i == 0) next
      k = substr(s, 1, i - 1); v = substr(s, i + 1)
      gsub(/[ \t]+$/, "", k); sub(/#.*$/, "", v); gsub(/^[ \t]+|[ \t]+$/, "", v)
      if (k == key) val = v
    }
    END { printf "%s", val }' "$1"
}

ORG_MANAGE=""   # cached: on | off
org_managed() { # → 0 when ohermes manages the Organization-Knowledge folders (dies on an invalid value)
  if [[ -z "$ORG_MANAGE" ]]; then
    local v; v="$(conf_value "$CONF" organization-knowledge manage_folders)"
    if [[ -z "$v" ]]; then ORG_MANAGE=on
    else ORG_MANAGE="$(bool_word "$v")" || die "${CONF#"$ROOT"/}: [organization-knowledge] manage_folders must be on or off, not '$v' (see: ohermes check)"
    fi
  fi
  [[ "$ORG_MANAGE" == on ]]
}

org_off_quiet() { [[ "$(bool_word "$(conf_value "$CONF" organization-knowledge manage_folders)")" == off ]]; }   # never dies

OK_REL="${DEPTS#"$ROOT"/Organization-Knowledge/}"   # Organization/Department — paths as seen inside the knowledge repository
# org_missing <Dept> <name> → the folders the employee's container mounts that do not exist, one per line,
# relative to Organization-Knowledge/ (= the root of a separate knowledge repository)
org_missing() {
  local s
  [[ -d "$ROOT/Organization-Knowledge/Organization/Assign" ]] || printf 'Organization/Assign\n'
  for s in "${ORG_SUB[@]}"; do [[ -d "$DEPTS/$1/Assign/$s" ]] || printf '%s/%s/Assign/%s\n' "$OK_REL" "$1" "$s"; done
  for s in "${ORG_SUB[@]}"; do [[ -d "$DEPTS/$1/$2/$s" ]] || printf '%s/%s/%s/%s\n' "$OK_REL" "$1" "$2" "$s"; done
  return 0
}
# manage_folders = off: list the folders still to be created in the knowledge repository (nothing is created here)
warn_org_missing() { # <Dept> <name>
  local m; m="$(org_missing "$1" "$2")"
  [[ -n "$m" ]] || return 0
  [[ -d "$DEPTS/$1" ]] || warn "department folder $OK_REL/$1 does not exist in Organization-Knowledge"
  warn "Organization-Knowledge is managed outside ohermes (manage_folders = off) — create these folders in it:"
  local l; while IFS= read -r l; do printf '     %s/\n' "$l" >&2; done <<<"$m"
  warn "until then Docker creates them empty (owned by root) when $2's container starts"
}

# check_conf <file> → prints "file:line: error|warning: …"; returns 1 when there are errors.
# Enforcement: cmd_reconf (egress proxy).
check_conf() {
  local file="$1" rel="${1#"$ROOT"/}"
  if [[ ! -f "$file" ]]; then
    info "no $rel — every website is allowed (default allow)"; return 0
  fi
  local n=0 errs=0 warns=0 section="" defaults=0 line s a b rest key val okseen=" "
  cerr()  { printf '%s:%d: %serror%s: %s\n' "$rel" "$n" "$R" "$N" "$1" >&2; errs=$((errs + 1)); }
  cwarn() { printf '%s:%d: %swarning%s: %s\n' "$rel" "$n" "$Y" "$N" "$1" >&2; warns=$((warns + 1)); }
  while IFS= read -r line || [[ -n "$line" ]]; do
    n=$((n + 1))
    line="${line%$'\r'}"
    s="${line#"${line%%[![:space:]]*}"}"; s="${s%"${s##*[![:space:]]}"}"
    [[ -z "$s" || "$s" == \#* ]] && continue
    if [[ "$s" == \[* ]]; then
      if [[ "$s" =~ ^\[web\]$ ]]; then section=web
      elif [[ "$s" == "[organization-knowledge]" ]]; then section=orgk
      elif [[ "$s" =~ ^\[web:organization\]$ ]]; then section=rules
      elif [[ "$s" =~ ^\[web:(department|user)=([^]]*)\]$ ]]; then
        key="${BASH_REMATCH[1]}"; val="${BASH_REMATCH[2]}"; section=rules
        if [[ "$key" == department ]]; then
          if ! valid_dept_name "$val"; then cerr "invalid department name '$val'"; section=bad
          elif ! dept_exists "$val"; then
            cwarn "department '$val' does not exist (yet) — rules kept"
          fi
        else
          if [[ ! "$val" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]]; then cerr "invalid server name '$val' (e.g. john-doe)"; section=bad
          elif ! name_taken "$val" >/dev/null; then cwarn "employee '$val' does not exist — rules kept"
          fi
        fi
      else
        cerr "unknown section '$s' — use [web], [web:organization], [web:department=<Dept>], [web:user=<name>], [organization-knowledge]"; section=bad
      fi
      continue
    fi
    if [[ "$section" == orgk ]]; then   # key = value
      if [[ "$s" =~ ^([A-Za-z_]+)[[:space:]]*=[[:space:]]*([^[:space:]#]*)[[:space:]]*(#.*)?$ ]]; then
        key="${BASH_REMATCH[1]}"; val="${BASH_REMATCH[2]}"
        if [[ "$key" != manage_folders ]]; then cerr "unknown setting '$key' in [organization-knowledge] (only manage_folders)"
        elif ! bool_word "$val" >/dev/null; then cerr "manage_folders must be on or off (also true/false, yes/no), not '$val'"
        elif [[ "$okseen" == *" $key "* ]]; then cerr "$key is set more than once"
        else okseen+="$key "
        fi
      else
        cerr "expected 'manage_folders = on|off' in [organization-knowledge], not '$s'"
      fi
      continue
    fi
    read -r a b rest <<<"$s"
    case "$section" in
      "")  cerr "rule outside a section: '$s'" ;;
      bad) cerr "rule under an invalid section: '$s'" ;;
      web)
        if [[ "$a" != default ]]; then cerr "only 'default allow' or 'default deny' belongs in [web]"
        elif [[ "$b" != allow && "$b" != deny ]]; then cerr "default must be allow or deny, not '$b'"
        elif [[ -n "$rest" && "$rest" != \#* ]]; then cerr "unexpected text after 'default $b' (comments start with #)"
        elif (( defaults++ )); then cerr "default is set more than once"
        fi ;;
      rules)
        if [[ "$a" != allow && "$a" != deny ]]; then cerr "action must be allow or deny, not '$a'"
        elif [[ -z "$b" ]]; then cerr "missing website after '$a'"
        else
          if ! valid_website "$b" && ! valid_ip "$b"; then
            cerr "invalid website '$b' — use example.com, *.example.com or one IP address (no path or port)"
          fi
        fi ;;
    esac
  done < "$file"
  if (( errs )); then
    printf '%s: %d error(s), %d warning(s) — the file is not valid\n' "$rel" "$errs" "$warns" >&2
    return 1
  fi
  if (( warns )); then info "$rel: OK ($warns warning(s))"; else info "$rel: OK"; fi
  return 0
}

# ---------------------------------------------------------------- web rules → egress proxy (Squid)
# ohermes.conf (validated by check_conf) → Squid ACLs. People are identified by their /28 subnet
# (EMP_NET_SUBNET of active employees); a department = the subnets of its active members.
# Order: AI provider allow → deny (organization, department, user) → allow → raw-IP deny → default.

# Website of an AI provider: the host of its base URL, else a well-known provider's API host.
provider_host() { # <provider> [<base url>]
  local p; p="$(lower "$1")"
  if [[ -n "${2:-}" ]]; then
    local h="${2#*://}"; h="${h%%/*}"; h="${h%%:*}"; lower "$h"; return 0
  fi
  # default API hosts of the API-key providers (Hermes v0.22.2 provider table, inference_base_url);
  # azure-foundry and custom have none — they need AI_BASE_URL
  case "$p" in
    openrouter) printf 'openrouter.ai' ;;
    anthropic)  printf 'api.anthropic.com' ;;
    openai|openai-api) printf 'api.openai.com' ;;
    gemini|google) printf 'generativelanguage.googleapis.com' ;;
    deepseek)   printf 'api.deepseek.com' ;;
    xai)        printf 'api.x.ai' ;;
    mistral)    printf 'api.mistral.ai' ;;
    fireworks)  printf 'api.fireworks.ai' ;;
    novita)     printf 'api.novita.ai' ;;
    alibaba)    printf 'dashscope-intl.aliyuncs.com' ;;
    xiaomi)     printf 'api.xiaomimimo.com' ;;
    tencent-tokenhub)  printf 'tokenhub.tencentmaas.com' ;;
    tencent-tokenplan) printf 'api.lkeap.cloud.tencent.com' ;;
    nvidia)     printf 'integrate.api.nvidia.com' ;;
    huggingface) printf 'router.huggingface.co' ;;
    zai)        printf 'api.z.ai' ;;
    kimi-coding) printf 'api.moonshot.ai' ;;
    kimi-coding-cn) printf 'api.moonshot.cn' ;;
    stepfun)    printf 'api.stepfun.ai' ;;
    minimax)    printf 'api.minimax.io' ;;
    minimax-cn) printf 'api.minimaxi.com' ;;
    ollama-cloud) printf 'ollama.com' ;;
    arcee)      printf 'api.arcee.ai' ;;
    gmi)        printf 'api.gmi-serving.com' ;;
    kilocode)   printf 'api.kilo.ai' ;;
    opencode-zen|opencode-go) printf 'opencode.ai' ;;
    ai-gateway) printf 'ai-gateway.vercel.sh' ;;
  esac
}

# Central AI provider website(s), always allowed for everyone: AI_PROVIDER_HOSTS, else derived
# from AI_PROVIDER / AI_BASE_URL.
ai_provider_hosts() {
  if [[ -n "$AI_PROVIDER_HOSTS" ]]; then printf '%s' "${AI_PROVIDER_HOSTS//,/ }"; return 0; fi
  [[ -n "$AI_PROVIDER" ]] || return 0
  local h; h="$(provider_host "$AI_PROVIDER" "$AI_BASE_URL")"
  [[ -n "$h" ]] || warn "no API host known for AI_PROVIDER=$AI_PROVIDER — set AI_BASE_URL or AI_PROVIDER_HOSTS in .env (otherwise default deny blocks the AI provider)"
  printf '%s' "$h"
  return 0
}

# One key of <name>'s personal model (Users/<name>/model/model.yaml, written by `ohermes model`)
model_get() { # <name> <provider|default|base_url>
  local f="$USERS/$1/model/model.yaml"
  [[ -f "$f" ]] || return 0
  awk -v k="$2" '$1 == k":" { $1=""; sub(/^ /, ""); gsub(/^["'"'"']|["'"'"']$/, ""); print; exit }' "$f"
}

valid_website() { # example.com | *.example.com (same rule as check_conf)
  local v; v="$(lower "$1")"; v="${v#\*.}"
  [[ "$v" =~ ^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+([a-z]{2,63}|xn--[a-z0-9-]{1,59})$ && ${#v} -le 253 ]]
}
# One IP address (IPv4 1.2.3.4 or IPv6 2001:db8::1). Raw-IP destinations are denied unless listed.
valid_ip() {
  local v="$1" o
  if [[ "$v" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]]; then
    for o in "${BASH_REMATCH[@]:1}"; do [[ "$o" =~ ^(0|[1-9][0-9]*)$ ]] && (( o <= 255 )) || return 1; done
    return 0
  fi
  v="$(lower "$v")"
  [[ "$v" =~ ^[0-9a-f:]+$ && "$v" == *:*:* && ${#v} -le 39 ]]
}
squid_domain() { local v; v="$(lower "$1")"; if [[ "$v" == \*.* ]]; then printf '.%s' "${v#\*.}"; else printf '%s' "$v"; fi; }

# gen_rules → Squid rules on stdout, warnings on stderr. ohermes.conf must already be valid.
gen_rules() {
  local -A subnet_of=() dept_of=() src_done=()
  local -a personal_ai=()
  local f name sn d
  for f in "$USERS"/*/.env; do
    [[ -f "$f" ]] || continue
    name="$(basename "$(dirname "$f")")"; [[ "$name" == _* ]] && continue
    sn="$(env_get "$f" EMP_NET_SUBNET)"
    if [[ ! "$sn" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}/28$ ]]; then warn "Users/$name/.env: no valid EMP_NET_SUBNET — $name gets only organization rules"; continue; fi
    subnet_of[$name]="$sn"
    # a personal AI model (ohermes model) → its provider's website is allowed for that person
    local mp; mp="$(model_get "$name" provider)"
    if [[ -n "$mp" ]]; then
      local mh; mh="$(provider_host "$mp" "$(model_get "$name" base_url)")"
      if [[ -n "$mh" ]] && valid_website "$mh"; then personal_ai+=("acl u_$name src $sn"$'\n'"acl ai_u_$name dstdomain -n $mh"$'\n'"http_access allow u_$name ai_u_$name !to_private"); src_done["u_$name"]=1
      else warn "Users/$name/model: AI provider '$mp' has no known website — add it to Config/ohermes.conf [web:user=$name]"; fi
    fi
    d="$(env_get "$f" EMP_DEPARTMENT)"; dept_of[$name]="$(lower "${d:-General}")"
  done

  local default=allow section="" scope="" target="" src="" line s a b rest entry n=0 i=0
  local -a denies=() allows=() srcs=()
  if [[ -f "$CONF" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
      n=$((n + 1)); line="${line%$'\r'}"
      s="${line#"${line%%[![:space:]]*}"}"; s="${s%"${s##*[![:space:]]}"}"
      [[ -z "$s" || "$s" == \#* ]] && continue
      if [[ "$s" == \[* ]]; then
        src=""
        if [[ "$s" == "[web]" ]]; then section=web
        elif [[ "$s" == "[web:organization]" ]]; then section=rules; scope=organization; target=""; src=hermes_clients
        elif [[ "$s" =~ ^\[web:(department|user)=([^]]*)\]$ ]]; then
          section=rules; scope="${BASH_REMATCH[1]}"; target="$(lower "${BASH_REMATCH[2]}")"
          if [[ "$scope" == user ]]; then
            if [[ -n "${subnet_of[$target]:-}" ]]; then src="u_$target"
              [[ -n "${src_done[$src]:-}" ]] || { srcs+=("acl $src src ${subnet_of[$target]}"); src_done[$src]=1; }
            else warn "${CONF#"$ROOT"/}:$n: [web:user=$target] not applied — no active employee '$target'"; src=skip
            fi
          else
            local members=""
            for name in "${!dept_of[@]}"; do [[ "${dept_of[$name]}" == "$target" ]] && members+=" ${subnet_of[$name]}"; done
            if [[ -n "$members" ]]; then src="d_$target"
              [[ -n "${src_done[$src]:-}" ]] || { srcs+=("acl $src src$(tr ' ' '\n' <<<"$members" | sort | tr '\n' ' ' | sed 's/ $//')"); src_done[$src]=1; }
            else warn "${CONF#"$ROOT"/}:$n: [web:department=$target] not applied — no active employee in that department"; src=skip
            fi
          fi
        else section=other   # [organization-knowledge]: not a web rule
        fi
        continue
      fi
      read -r a b rest <<<"$s"
      if [[ "$section" == web ]]; then default="$b"; continue; fi
      [[ "$src" == skip || -z "$src" ]] && continue
      i=$((i + 1))
      # -n: never match through reverse DNS (an IP whose PTR is x.example.com must not pass as *.example.com)
      if valid_ip "$b"; then d="$(lower "$b")"; [[ "$d" == *:* ]] && d="[$d]"; else d="$(squid_domain "$b")"; fi
      entry="# ${CONF#"$ROOT"/}:$n  $scope${target:+ $target}: $a $b${rest:+  — $rest}"$'\n'"acl r$i dstdomain -n $d"$'\n'"http_access $a $src r$i"
      # allow lines end with !to_private: Squid resolves a name (DNS) only after it was allowed (H-04)
      [[ "$a" == allow ]] && entry+=" !to_private"
      if [[ "$a" == deny ]]; then denies+=("$scope|$entry"); else allows+=("$entry"); fi
    done < "$CONF"
  fi

  # deny order: organization → department → user (all deny anyway; order only helps reading)
  local -a sorted=()
  for scope in organization department user; do
    for s in "${denies[@]}"; do [[ "${s%%|*}" == "$scope" ]] && sorted+=("${s#*|}"); done
  done

  printf '# GENERATED by `ohermes reconf` from Config/ohermes.conf — do not edit (%s)\n' "$(date '+%F %T')"
  printf '# Names are decided first (no DNS); every allow line ends with !to_private (squid.conf), so a\n'
  printf '# name is looked up only once it is allowed, and refused if it points into a private range.\n'
  printf '# default %s\n\n' "$default"
  printf 'acl hermes_clients src %s.0.0/16\n' "$NETWORK_PREFIX"
  for s in "${srcs[@]}"; do printf '%s\n' "$s"; done
  printf '\n# 1) AI provider — always allowed\n'
  local h hosts=""
  for h in $(ai_provider_hosts); do
    if valid_website "$h"; then hosts+=" $(squid_domain "$h")"; else warn ".env: AI_PROVIDER_HOSTS: '$h' is not a website — ignored"; fi
  done
  if [[ -n "$hosts" ]]; then
    printf 'acl ai_provider dstdomain -n%s\nhttp_access allow hermes_clients ai_provider !to_private\n' "$hosts"
  else
    warn "no AI provider website — set AI_PROVIDER (+ AI_BASE_URL) or AI_PROVIDER_HOSTS in .env"
    printf '# (none — set AI_PROVIDER or AI_PROVIDER_HOSTS in .env)\n'
  fi
  for s in "${personal_ai[@]}"; do printf '# personal AI model (ohermes model)\n%s\n' "$s"; done
  printf '\n# 2) deny rules (organization, department, user)\n'
  for s in "${sorted[@]}"; do printf '%s\n' "$s"; done
  printf '\n# 3) allow rules\n'
  for s in "${allows[@]}"; do printf '%s\n' "$s"; done
  printf '\n# 4) raw IP addresses (1.2.3.4, [2001:db8::1], 0x7f.1, 2130706433 …: no name ending in a letter label)\n'
  printf '#    are denied unless an allow rule above lists that IP — in default allow AND default deny\n'
  printf 'acl named_host dstdom_regex -n -i [.][a-z][a-z0-9-]*[.]?$\nhttp_access deny hermes_clients !named_host\n'
  printf '\n# 5) default\n'
  if [[ "$default" == allow ]]; then printf 'http_access allow hermes_clients !to_private\n'; else printf '# default deny: everything else is refused by squid.conf (http_access deny all)\n'; fi
}

EGRESS_DIR="$ROOT/Infrastructure/egress"
EGRESS_CONF_IN=/etc/squid/hermes/squid.conf   # path inside the egress container

egress_running() { dc ps --status running --services 2>/dev/null | grep -qx egress; }

# squid -k parse of generated/<file> (inside the running egress container, or a throwaway one)
squid_parse() { # <file name in generated/>
  local cmd="sed 's#/etc/squid/hermes/generated/rules.conf#/etc/squid/hermes/generated/$1#' $EGRESS_CONF_IN > /tmp/hermes-parse.conf && squid -k parse -f /tmp/hermes-parse.conf"
  if egress_running; then
    dc exec -T egress sh -c "$cmd"
  else
    docker run --rm --network none --entrypoint sh -v "$DROOT/Infrastructure/egress:/etc/squid/hermes:ro" "$EGRESS_IMAGE" -c "$cmd"
  fi
}

squid_reload() {
  egress_running || { info "egress is not running — the rules apply when it starts"; return 0; }
  if dc exec -T egress test -f /run/hermes-first-boot; then
    info "egress started without rules (first boot) — restarting it"
    dc restart egress >/dev/null || return 1
  else
    local out
    out="$(dc exec -T egress squid -f "$EGRESS_CONF_IN" -k reconfigure 2>&1)" || { printf '%s
' "$out" >&2; return 1; }
  fi
  sleep 2
  egress_running
}

cmd_reconf() {
  local dry=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -n|--dry-run) dry=1; shift ;;
      -h|--help) usage_cmd reconf; exit 0 ;;
      *) die "unknown option: $1 (see: ohermes reconf --help)" ;;
    esac
  done
  load_env
  conf_fallback
  check_conf "$CONF" >&2 || die "${CONF#"$ROOT"/} is not valid — web rules NOT changed (the previous rules stay active)"
  if (( dry )); then gen_rules; return 0; fi
  require_admin

  local gen="$EGRESS_DIR/generated" out
  mkdir -p "$gen"
  gen_rules > "$gen/rules.conf.new" || { rm -f "$gen/rules.conf.new"; die "could not generate the rules — previous rules stay active"; }
  if ! out="$(squid_parse rules.conf.new 2>&1)"; then
    printf '%s\n' "$out" | grep -E 'ERROR|FATAL|unrecognized|Bungled' >&2 || printf '%s\n' "$out" | tail -n 5 >&2
    rm -f "$gen/rules.conf.new"
    die "Squid rejected the generated rules — previous rules stay active"
  fi
  [[ -f "$gen/rules.conf" ]] && cp -p "$gen/rules.conf" "$gen/rules.conf.prev"
  mv -f "$gen/rules.conf.new" "$gen/rules.conf"
  if ! squid_reload; then
    if [[ -f "$gen/rules.conf.prev" ]]; then mv -f "$gen/rules.conf.prev" "$gen/rules.conf"; else rm -f "$gen/rules.conf"; fi
    squid_reload >/dev/null 2>&1 || true
    die "egress did not accept the new rules — previous rules restored (see: docker compose logs egress)"
  fi
  ok "web rules applied ($(grep -c '^http_access' "$gen/rules.conf") rule line(s), default $(awk '/^# default/ {print $3; exit}' "$gen/rules.conf"))"
}

# create/update/rm/restore: apply the rules for the new set of employees; never fails the command
auto_reconf() {
  ( cmd_reconf ) || warn "web rules were NOT updated — fix the problem above, then run: ohermes reconf"
}

# ---------------------------------------------------------------- commands
cmd_create() {
  local email="" subdomain="" password="" department="" title="" pw_flag=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -e|--email)      email="${2:-}"; shift 2 ;;
      -s|--subdomain)  subdomain="${2:-}"; shift 2 ;;
      -p|--password)   password="${2:-}"; pw_flag=1; shift 2 ;;
      -d|--department) department="${2:-}"; shift 2 ;;
      -t|--title)      title="${2:-}"; shift 2 ;;
      -u|--username)   die "create does not take -u — the server name comes from the email (-e)" ;;
      -h|--help) usage_cmd create; exit 0 ;;
      *) die "unknown option: $1 (see: ohermes create --help)" ;;
    esac
  done
  [[ -n "$email" ]] || die "missing -e <email> (see: ohermes create --help)"
  [[ -n "$subdomain" ]] || die "missing -s <subdomain> (see: ohermes create --help)"
  email="$(lower "$email")"; subdomain="$(lower "$subdomain")"
  validate_email "$email"
  validate_subdomain "$subdomain"
  validate_text title "$title"
  local name; name="$(name_from_email "$email")"
  validate_name "$name"
  department="$(resolve_department "$department")"
  require_admin
  load_env
  org_managed || true   # validate [organization-knowledge] before anything is created

  local where
  if where="$(name_taken "$name")"; then
    [[ "$where" == Archive/* ]] && die "$name is archived ($where) — bring them back with: ohermes restore -u $name"
    die "server name '$name' (from $email) is already used: $where — decide which name to use"
  fi
  where="$(email_owner "$email")" && die "email $email is already used: $where"
  where="$(subdomain_owner "$subdomain")" && die "subdomain '$subdomain' is already used: $where"

  if (( pw_flag )); then
    warn "a password given with -p is saved in your shell history — prefer leaving -p out"
  else
    ask_password "$name"; password="$PASSWORD"
  fi
  check_password "$password"


  info "Creating $name …"
  local hash secret net_id dir="$USERS/$name" person="$DEPTS/$department/$name"
  hash="$(printf '%s' "$password" | hash_password)" || die "could not hash the password with $HERMES_IMAGE"
  [[ "$hash" == scrypt\$* ]] || die "unexpected password hash format"
  secret="$(random_hex)"
  net_id="$(next_net_id)"

  mkdir -p "$dir"
  cp -R "$TEMPLATE/." "$dir/"
  sed "s/__USER__/$name/g" "$TEMPLATE/compose.yml" > "$dir/compose.yml"
  mkdir -p "$dir/data"
  if org_managed; then
    ensure_department "$department"
    ensure_person_dirs "$person"
  else
    warn_org_missing "$department" "$name"
  fi

  ( umask 077
    cat > "$dir/.env" <<ENV
# $name — managed by ohermes. Never commit this file.
EMP_USERNAME=$(sq "$name")
EMP_EMAIL=$(sq "$email")
EMP_SUBDOMAIN=$(sq "$subdomain")
EMP_DEPARTMENT=$(sq "$department")
EMP_TITLE=$(sq "$title")
EMP_CREATED_AT=$(sq "$(date +%F)")
EMP_NET_ID=$(sq "$net_id")
EMP_NET_SUBNET=$(sq "$(subnet_of "$net_id")")
EMP_CPUS=$(sq "$DEFAULT_CPUS")
EMP_MEMORY=$(sq "$DEFAULT_MEMORY")

# Hermes dashboard login
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=$(sq "$name")
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH=$(sq "$hash")
HERMES_DASHBOARD_BASIC_AUTH_SECRET=$(sq "$secret")

# AI model + key: root .env (AI_*) for everyone, or a personal one with: ohermes model -u <name>
ENV
  )
  chmod 600 "$dir/.env"
  unset password PASSWORD

  register "$name"
  info "Starting containers (the entry and egress proxies restart for a moment to join the new network) …"
  dc up -d --remove-orphans
  caddy_reload || true
  auto_reconf

  ok "created $name ($email, $department) → $(user_url "$subdomain")"
  info "Dashboard login: $name · personal folder: ${person#"$ROOT"/}/"
  info "Next:"
  [[ "${STAGE:-prod}" != dev ]] && info "  - Cloudflare Access: allow ${B}$email${N} on ${B}$subdomain.${HERMES_DOMAIN}${N} (until then the catch-all *.${HERMES_DOMAIN} Access app keeps it closed)"
  [[ -z "$AI_API_KEY" ]] && info "  - set AI_PROVIDER / AI_MODEL / AI_API_KEY in .env (central), or: ohermes model -u $name"
  info "  - send $name the link $(user_url "$subdomain") and the password (by a private channel)"
  return 0
}

cmd_update() {
  local ref="" department="" title="" email="" subdomain="" set_d=0 set_t=0 set_e=0 set_s=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -u|--username)   ref="${2:-}"; shift 2 ;;
      -d|--department) department="${2:-}"; set_d=1; shift 2 ;;
      -t|--title)      title="${2:-}"; set_t=1; shift 2 ;;
      -e|--email)      email="${2:-}"; set_e=1; shift 2 ;;
      -s|--subdomain)  subdomain="${2:-}"; set_s=1; shift 2 ;;
      -h|--help) usage_cmd update; exit 0 ;;
      *) die "unknown option: $1 (see: ohermes update --help)" ;;
    esac
  done
  [[ -n "$ref" ]] || die "missing -u <server name or email> (see: ohermes update --help)"
  (( set_d + set_t + set_e + set_s )) || die "nothing to change — give -d, -t, -e and/or -s"
  resolve_user "$ref" active
  local name="$NAME" f="$USERS/$NAME/.env" where
  [[ -f "$f" ]] || die "$ref is not an active employee"
  require_admin
  load_env

  local old_dept new_dept="" old_sub
  old_dept="$(env_get "$f" EMP_DEPARTMENT)"; [[ -n "$old_dept" ]] || old_dept=General
  old_sub="$(env_get "$f" EMP_SUBDOMAIN)"
  if (( set_t )); then validate_text title "$title"; fi
  if (( set_e )); then
    email="$(lower "$email")"; validate_email "$email"
    where="$(email_owner "$email" "$name")" && die "email $email is already used: $where"
  fi
  if (( set_s )); then
    subdomain="$(lower "$subdomain")"; validate_subdomain "$subdomain"
    where="$(subdomain_owner "$subdomain" "$name")" && die "subdomain '$subdomain' is already used: $where"
  fi
  if (( set_d )); then
    new_dept="$(resolve_department "$department")"
    [[ "$new_dept" == "$old_dept" ]] && { info "$name is already in $new_dept"; set_d=0; }
  fi
  if (( set_d )) && org_managed; then
    [[ -e "$DEPTS/$new_dept/$name" ]] && die "${DEPTS#"$ROOT"/}/$new_dept/$name already exists — move or merge it by hand first"
  fi

  if (( set_d )) && ! org_managed; then
    # manage_folders = off: the personal folder is moved in the knowledge repository, not here
    env_set "$f" EMP_DEPARTMENT "$new_dept"
    ok "department: $old_dept → $new_dept (Organization-Knowledge not touched: manage_folders = off)"
    if [[ -d "$DEPTS/$old_dept/$name" && ! -e "$DEPTS/$new_dept/$name" ]]; then
      warn "move the personal folder in the Organization-Knowledge repository: $OK_REL/$old_dept/$name → $OK_REL/$new_dept/$name"
    elif [[ -d "$DEPTS/$old_dept/$name" ]]; then
      warn "$OK_REL/$old_dept/$name still exists next to $OK_REL/$new_dept/$name — remove the old one in the Organization-Knowledge repository if it is no longer needed"
    fi
    warn_org_missing "$new_dept" "$name"
  elif (( set_d )); then
    # stop first: the personal folders are bind-mounted into the running container
    dc stop "$name" >/dev/null 2>&1 || true
    ensure_department "$new_dept"
    if [[ -d "$DEPTS/$old_dept/$name" ]]; then
      mv "$DEPTS/$old_dept/$name" "$DEPTS/$new_dept/$name" \
        || { dc up -d "$name" >/dev/null 2>&1 || true; die "could not move the personal folder — nothing changed"; }
    fi
    ensure_person_dirs "$DEPTS/$new_dept/$name"
    env_set "$f" EMP_DEPARTMENT "$new_dept"
    ok "department: $old_dept → $new_dept (personal folder moved)"
  fi
  if (( set_t )); then env_set "$f" EMP_TITLE "$title"; ok "title: ${title:-(none)}"; fi
  if (( set_e )); then env_set "$f" EMP_EMAIL "$email"; ok "email: $email (server name stays $name)"; fi
  if (( set_s )); then env_set "$f" EMP_SUBDOMAIN "$subdomain"; ok "subdomain: $old_sub → $subdomain"; fi

  (( set_s )) && write_routes
  dc up -d "$name"
  (( set_s )) && { caddy_reload || true; }
  auto_reconf
  ok "$name restarted → $(user_url "$(env_get "$f" EMP_SUBDOMAIN)")"
  if [[ "${STAGE:-prod}" != dev ]]; then
    (( set_s )) && warn "the old link $(user_url "$old_sub") no longer works — update Cloudflare Access/DNS to ${subdomain}.${HERMES_DOMAIN}"
    (( set_e )) && warn "update the email in Cloudflare Access to $email"
  fi
  return 0
}

cmd_rm() {
  parse_u "$@"
  resolve_user "$REF" active
  local name="$NAME" dir="$USERS/$NAME"
  [[ -d "$dir" ]] || die "$REF is not an active employee (no Users/$name)"
  require_admin
  load_env
  local dept person dest n=2
  dept="$(env_get "$dir/.env" EMP_DEPARTMENT)"; [[ -n "$dept" ]] || dept=General
  person="$DEPTS/$dept/$name"
  local manage=1; org_managed || manage=0
  (( manage )) && [[ -e "$dir/$ARCHIVED_ORG" ]] && die "Users/$name/$ARCHIVED_ORG already exists — move it away first"
  dest="$ARCHIVE/${name}_$(date +%F)"
  while [[ -e "$dest" ]]; do dest="$ARCHIVE/${name}_$(date +%F)-$n"; n=$((n + 1)); done

  echo
  printf '%s⚠  This does NOT delete any data.%s\n' "$Y$B" "$N"
  echo "   $name's container will be stopped to free resources, and all of their data"
  if (( manage )); then
    echo "   (Users/$name and ${person#"$ROOT"/}) will be moved to ${dest#"$ROOT"/}/"
  else
    echo "   (Users/$name) will be moved to ${dest#"$ROOT"/}/"
    echo "   ${person#"$ROOT"/} stays where it is (manage_folders = off: managed in its own repository)"
  fi
  [[ "${STAGE:-prod}" != dev ]] && echo "   Don't forget: remove $(env_get "$dir/.env" EMP_EMAIL) from Cloudflare Access + revoke their API key."
  echo
  confirm "Continue?" || { info "cancelled — nothing changed"; exit 0; }

  dc stop "$name" || die "could not stop $name — nothing was moved"
  dc rm -f "$name" >/dev/null || die "could not remove the $name container — nothing was moved"
  mkdir -p "$ARCHIVE"; chmod 700 "$ARCHIVE" 2>/dev/null || true   # archived .env, chats, KPIs
  # personal Organization-Knowledge folder travels inside the employee folder
  if (( manage )) && [[ -d "$person" ]] && ! mv "$person" "$dir/$ARCHIVED_ORG"; then
    dc up -d "$name" >/dev/null 2>&1 || true
    die "could not move ${person#"$ROOT"/} — restarted $name, nothing changed"
  fi
  if ! mv "$dir" "$dest"; then
    [[ -d "$dir/$ARCHIVED_ORG" ]] && mv "$dir/$ARCHIVED_ORG" "$person"
    dc up -d "$name" >/dev/null 2>&1 || true
    die "could not move Users/$name to the archive — restarted $name, nothing changed"
  fi
  if (( ! manage )); then
    cat > "$dest/$ARCHIVED_ORG.README" <<NOTE
Archived with [organization-knowledge] manage_folders = off (Config/ohermes.conf) on $(date +%F):
the personal folder was NOT moved into this archive. It stayed in the Organization-Knowledge
repository at $OK_REL/$dept/$name/ (if it existed).
NOTE
  fi
  unregister "$name"
  dc up -d --remove-orphans
  caddy_reload || true
  docker network rm "$(project_name)_$name" >/dev/null 2>&1 || true
  auto_reconf

  ok "$name stopped — data kept in ${dest#"$ROOT"/}/"
  (( manage )) || warn "Organization-Knowledge not touched (manage_folders = off): archive or remove $OK_REL/$dept/$name in its repository if needed"
  [[ "${STAGE:-prod}" != dev ]] && warn "Cloudflare Access: remove $(env_get "$dest/.env" EMP_EMAIL) from $(env_get "$dest/.env" EMP_SUBDOMAIN).${HERMES_DOMAIN}  ·  revoke their AI provider API key"
  return 0
}

cmd_restore() {
  parse_u "$@"
  resolve_user "$REF" archived
  local name="$NAME"
  require_admin
  load_env
  [[ -e "$USERS/$name" ]] && die "$name is already active"
  local candidates=() d pick
  for d in "$ARCHIVE/${name}_"*; do [[ -f "$d/.env" ]] && candidates+=("$d"); done
  (( ${#candidates[@]} )) || die "no archive found for $REF"

  if (( ${#candidates[@]} == 1 )); then
    pick="${candidates[0]}"
  else
    info "Archives for $name:"
    local i
    for i in "${!candidates[@]}"; do printf '  %d) %s\n' $((i + 1)) "$(basename "${candidates[$i]}")"; done
    read -rp "Restore which one? [1-${#candidates[@]}] " i || true
    [[ "$i" =~ ^[0-9]+$ ]] && (( i >= 1 && i <= ${#candidates[@]} )) || die "cancelled"
    pick="${candidates[$((i - 1))]}"
  fi

  local dept person where
  dept="$(env_get "$pick/.env" EMP_DEPARTMENT)"
  valid_dept_name "${dept:-x}" || { warn "archived department '$dept' is not a valid folder name — using General"; dept=""; }
  dept="$(resolve_department "$dept")"   # older archives may hold e.g. "sales" → Sales
  person="$DEPTS/$dept/$name"
  local manage=1; org_managed || manage=0
  # the archived copy only comes back when ohermes manages the folders (an archive made with
  # manage_folders = off has none: the person folder stayed in Organization-Knowledge and is reused)
  (( manage )) && [[ -d "$pick/$ARCHIVED_ORG" && -e "$person" ]] \
    && die "${person#"$ROOT"/} already exists — move it away first, nothing changed"
  where="$(subdomain_owner "$(subdomain_of_env "$pick/.env")")" && [[ "$where" != Archive/* ]]     && die "subdomain is now used by $where — change it in ${pick#"$ROOT"/}/.env first"

  echo "Restore $name from ${pick#"$ROOT"/}/ — their memory, data and personal folder come back as they were."
  confirm "Continue?" || { info "cancelled — nothing changed"; exit 0; }

  local dir="$USERS/$name" f="$USERS/$name/.env"
  mv "$pick" "$dir"
  rm -f "$dir/$ARCHIVED_ORG.README"
  if (( manage )); then
    ensure_department "$dept"
    if [[ -d "$dir/$ARCHIVED_ORG" ]]; then
      mv "$dir/$ARCHIVED_ORG" "$person" || warn "could not move the personal folder back — it is in Users/$name/$ARCHIVED_ORG"
    fi
    ensure_person_dirs "$person"
  else
    if [[ -d "$dir/$ARCHIVED_ORG" ]]; then
      # archived while manage_folders was on: the copy stays in the archive (no .env there, so it is
      # not an archived employee) — copy it into the knowledge repository by hand if needed
      if mkdir -p "$pick" && mv "$dir/$ARCHIVED_ORG" "$pick/$ARCHIVED_ORG"; then
        warn "the archived personal folder stays in ${pick#"$ROOT"/}/$ARCHIVED_ORG (manage_folders = off) — add it to the Organization-Knowledge repository as $OK_REL/$dept/$name/ if needed"
      else
        warn "could not move Users/$name/$ARCHIVED_ORG back to ${pick#"$ROOT"/}/ — it is still in Users/$name/"
      fi
    fi
    warn_org_missing "$dept" "$name"
  fi
  upgrade_legacy "$name" "$dept" "$person" "$manage"
  register "$name"
  dc up -d --remove-orphans
  caddy_reload || true
  auto_reconf
  ok "$name is back ($dept) → $(user_url "$(env_get "$f" EMP_SUBDOMAIN)")"
  if [[ -z "$(env_get "$f" EMP_EMAIL)" ]]; then
    warn "$name has no email yet — set it with: ohermes update -u $name -e <email>"
  elif [[ "${STAGE:-prod}" != dev ]]; then
    warn "Cloudflare Access: allow $(env_get "$f" EMP_EMAIL) again · set a new API key if the old one was revoked"
  fi
  return 0
}

# compose.yml written from an older template: no Organization-Knowledge mounts / egress proxy /
# settings lock (runtime/SOUL.md), or the whole Config/ folder mounted (the agent could read
# Config/ohermes.conf) → regenerate it from the template
compose_outdated() { # <compose.yml>
  [[ -f "$1" ]] || return 0
  ! grep -q "Organization-Knowledge" "$1" || ! grep -q "egress:3128" "$1" || ! grep -q "runtime/SOUL.md" "$1" \
    || ! grep -q "employee.internal" "$1" || ! grep -q "runtime/shell-rc" "$1" || ! grep -q "runtime/models_dev_cache.json" "$1" || grep -qE '\.\./\.\./Config/?:' "$1"
}

# Employees archived before v0.6 (Users/<name>/knowledge, EMP_SLUG, dotted EMP_USERNAME,
# compose.yml mounting Shared/) are brought up to the current layout on restore.
upgrade_legacy() { # <name> <Dept> <person dir> <manage: 1|0>
  local dir="$USERS/$1" f="$USERS/$1/.env"
  [[ "$(env_get "$f" EMP_DEPARTMENT)" == "$2" ]] || env_set "$f" EMP_DEPARTMENT "$2"
  [[ "$(env_get "$f" EMP_USERNAME)" == "$1" ]] || env_set "$f" EMP_USERNAME "$1"
  [[ -n "$(env_get "$f" EMP_SUBDOMAIN)" ]] || env_set "$f" EMP_SUBDOMAIN "$(subdomain_of_env "$f")"
  if [[ -d "$dir/knowledge" && "${4:-1}" == 0 ]]; then
    warn "Users/$1/knowledge (old layout) — copy it into $OK_REL/$2/$1/Knowledge in the Organization-Knowledge repository by hand"
  elif [[ -d "$dir/knowledge" ]]; then
    if cp -R "$dir/knowledge/." "$3/Knowledge/" 2>/dev/null; then
      mv "$dir/knowledge" "$dir/knowledge.migrated"
      info "moved the old Users/$1/knowledge into ${3#"$ROOT"/}/Knowledge (copy kept as Users/$1/knowledge.migrated)"
    else
      warn "could not copy Users/$1/knowledge — move it into ${3#"$ROOT"/}/ by hand"
    fi
  fi
  [[ -f "$dir/config.yaml" ]] || cp "$TEMPLATE/config.yaml" "$dir/config.yaml"
  mkdir -p "$dir/data"
  if compose_outdated "$dir/compose.yml"; then
    [[ -f "$dir/compose.yml" ]] && mv "$dir/compose.yml" "$dir/compose.yml.old"
    sed "s/__USER__/$1/g" "$TEMPLATE/compose.yml" > "$dir/compose.yml"
    info "Users/$1/compose.yml regenerated from the template (old file kept as compose.yml.old)"
  fi
}

cmd_repasswd() {
  parse_u "$@"
  resolve_user "$REF" active
  local name="$NAME" f="$USERS/$NAME/.env"
  [[ -f "$f" ]] || die "$REF is not an active employee"
  require_admin
  load_env
  ask_password "$name"; check_password "$PASSWORD"
  local hash secret
  hash="$(printf '%s' "$PASSWORD" | hash_password)" || die "could not hash the password"
  [[ "$hash" == scrypt\$* ]] || die "unexpected password hash format"
  unset PASSWORD
  secret="$(random_hex)"   # new signing key → existing sessions are logged out
  env_set "$f" HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH "$hash"
  env_set "$f" HERMES_DASHBOARD_BASIC_AUTH_SECRET "$secret"
  dc up -d "$name"
  ok "password changed for $name (existing sessions were signed out)"
}

# ---------------------------------------------------------------- AI model (central .env / personal)
mask() { local v="$1"; if [[ -z "$v" ]]; then printf '(none)'; elif (( ${#v} > 4 )); then printf '…%s' "${v: -4}"; else printf '(set)'; fi; }

model_source() { [[ -f "$USERS/$1/model/model.yaml" && -f "$USERS/$1/model/model.env" ]] && echo personal || echo central; }

model_show() { # <name>
  local name="$1" src; src="$(model_source "$name")"
  if [[ "$src" == personal ]]; then
    local line; line="$(grep -E '^[A-Z][A-Z0-9_]*=' "$USERS/$name/model/model.env" | head -n1)"
    info "$name: personal model (Users/$name/model/)"
    info "  provider : $(model_get "$name" provider)"
    info "  model    : $(model_get "$name" default)"
    [[ -n "$(model_get "$name" base_url)" ]] && info "  base_url : $(model_get "$name" base_url)"
    info "  key      : ${line%%=*} = $(mask "${line#*=}")"
  else
    info "$name: central model (root .env)"
    info "  provider : ${AI_PROVIDER:-(not set)}"
    info "  model    : ${AI_MODEL:-(not set)}"
    [[ -n "$AI_BASE_URL" ]] && info "  base_url : $AI_BASE_URL"
    info "  key      : AI_API_KEY = $(mask "$AI_API_KEY")"
  fi
}

cmd_model() {
  local ref="" show=0 reset=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -u|--username) ref="${2:-}"; shift 2 ;;
      --show) show=1; shift ;;
      --reset) reset=1; shift ;;
      -h|--help) usage_cmd model; exit 0 ;;
      *) die "unknown option: $1 (see: ohermes model --help)" ;;
    esac
  done
  [[ -n "$ref" ]] || die "missing -u <server name or email> (see: ohermes model --help)"
  (( show + reset < 2 )) || die "use either --show or --reset"
  resolve_user "$ref" active
  local name="$NAME" dir="$USERS/$NAME"
  [[ -f "$dir/.env" ]] || die "$ref is not an active employee"
  require_admin
  load_env
  if (( show )); then model_show "$name"; return 0; fi

  ensure_runtime "$name"
  if (( reset )); then
    [[ "$(model_source "$name")" == personal ]] || { info "$name already uses the central model"; return 0; }
    rm -f "$dir/model/model.yaml" "$dir/model/model.env"
    dc restart "$name" >/dev/null
    auto_reconf
    ok "$name now uses the central model (${AI_PROVIDER:-?} / ${AI_MODEL:-?})"
    return 0
  fi

  [[ -t 0 && -t 1 ]] || die "ohermes model is interactive — run it in a terminal on the server"
  local net; net="$(project_name)_$name"
  docker network inspect "$net" >/dev/null 2>&1 || die "network $net not found — start $name first (docker compose up -d $name)"
  local tmp="$dir/model/.new"
  rm -rf "$tmp"; ( umask 077; mkdir -p "$tmp" )
  info "Starting Hermes' own model picker in a temporary container (nothing of $name's live Hermes is used)."
  info "Choose the provider and model and enter the API key; it is saved for $name only."
  local rc=0
  # throwaway container: temporary HERMES_HOME on tmpfs, the employee's network → egress proxy only
  docker run --rm -it --network "$net" --tmpfs /tmp/hm:mode=0700 \
    -e HERMES_HOME=/tmp/hm -e HTTP_PROXY=http://egress:3128 -e HTTPS_PROXY=http://egress:3128 \
    -e http_proxy=http://egress:3128 -e https_proxy=http://egress:3128 -e NO_PROXY=localhost,127.0.0.1 \
    -v "$DROOT/Infrastructure/hermes:/opt/enterprise/bin:ro" -v "$(dpath "$tmp"):/out" \
    --cap-drop ALL --security-opt no-new-privileges:true \
    --entrypoint /bin/sh "$HERMES_IMAGE" -c \
    '/opt/hermes/.venv/bin/hermes model && /opt/hermes/.venv/bin/python /opt/enterprise/bin/model_capture.py /tmp/hm /out' \
    || rc=$?
  if (( rc != 0 )) || [[ ! -s "$tmp/model.yaml" || ! -s "$tmp/model.env" ]]; then
    rm -rf "$tmp"
    die "nothing changed for $name (model picker cancelled or failed)"
  fi
  mv -f "$tmp/model.yaml" "$dir/model/model.yaml"
  mv -f "$tmp/model.env" "$dir/model/model.env"
  rm -rf "$tmp"
  chmod 600 "$dir/model/model.yaml" "$dir/model/model.env"
  dc restart "$name" >/dev/null
  auto_reconf
  ok "$name now uses a personal model — restarted $name"
  model_show "$name"
}

# Rebuild docker-compose.override.yml from Users/ and make sure every employee folder has the
# files Docker needs. Safe to run any time (deploys, after copying folders by hand).
cmd_sync() {
  [[ "${1:-}" == -h || "${1:-}" == --help ]] && { usage_cmd sync; exit 0; }
  require_admin
  move_legacy_conf
  local n manage=1
  org_managed || manage=0   # off: Organization-Knowledge is never touched (not even chmod)
  while IFS= read -r n; do
    [[ -n "$n" ]] || continue
    ensure_runtime "$n"
    # employees created before the current template: bring their compose.yml up to it
    if compose_outdated "$USERS/$n/compose.yml"; then
      mv "$USERS/$n/compose.yml" "$USERS/$n/compose.yml.old"
      sed "s/__USER__/$n/g" "$TEMPLATE/compose.yml" > "$USERS/$n/compose.yml"
      info "Users/$n/compose.yml regenerated from the template (old file kept as compose.yml.old)"
    fi
    local dept; dept="$(env_get "$USERS/$n/.env" EMP_DEPARTMENT)"
    if (( manage )); then
      [[ -d "$DEPTS/${dept:-General}/$n" ]] && chmod 700 "$DEPTS/${dept:-General}/$n" 2>/dev/null
    else
      [[ -z "$(org_missing "${dept:-General}" "$n")" ]] || warn "$n: Organization-Knowledge folders missing (manage_folders = off) — see: ohermes ls"
    fi
    grep -qE '^[A-Z0-9_]*_API_KEY=..' "$USERS/$n/.env" \
      && warn "Users/$n/.env still holds an AI key — it is no longer used (central AI_* in .env, or: ohermes model -u $n)"
  done < <(active_names)
  write_override
  caddy_reload || true
  ok "docker-compose.override.yml + Caddy routes: $(active_names | grep -c . || true) employee(s) — apply with: docker compose up -d"
}

cmd_ls() {
  [[ "${1:-}" == -h || "${1:-}" == --help ]] && { usage_cmd ls; exit 0; }
  load_env
  local running
  running="$(dc ps --services --status running 2>/dev/null || true)"
  # ORG = the Organization-Knowledge folders the container mounts (department Assign/ + personal
  # Skills/KPI/Knowledge): ok | missing — useful with manage_folders = off (shown in both modes)
  local fmt='%-16s %-28s %-16s %-14s %-18s %-9s %-8s %-34s %s\n'
  # shellcheck disable=SC2059
  printf "$B$fmt$N" USERNAME EMAIL SUBDOMAIN DEPARTMENT TITLE STATUS ORG "MODEL (SOURCE)" URL
  local d f name st model dept org
  for d in "$USERS"/*/; do
    name="$(basename "$d")"; [[ "$name" == _* ]] && continue
    f="$d/.env"
    if grep -qx "$name" <<<"$running"; then st=running; else st=stopped; fi
    if [[ "$(model_source "$name")" == personal ]]; then model="$(model_get "$name" default) (personal)"
    else model="${AI_MODEL:-?} (central)"; fi
    dept="$(env_get "$f" EMP_DEPARTMENT)"
    if [[ -z "$(org_missing "${dept:-General}" "$name")" ]]; then org=ok; else org=missing; fi
    # shellcheck disable=SC2059
    printf "$fmt" "$name" "$(env_get "$f" EMP_EMAIL)" "$(subdomain_of_env "$f")" "$dept" \
      "$(env_get "$f" EMP_TITLE)" "$st" "$org" "$model" "$(user_url "$(subdomain_of_env "$f")")"
  done
  for d in "$ARCHIVE"/*/; do
    f="$d/.env"
    [[ -f "$f" ]] || continue   # e.g. a personal folder left in Archive/ by restore with manage_folders = off
    # shellcheck disable=SC2059
    printf "$fmt" "$(archive_name "$d")" "$(env_get "$f" EMP_EMAIL)" "$(subdomain_of_env "$f")" "$(env_get "$f" EMP_DEPARTMENT)" \
      "$(env_get "$f" EMP_TITLE)" archived - - "Archive/$(basename "$d")"
  done
}

cmd_check() {
  [[ "${1:-}" == -h || "${1:-}" == --help ]] && { usage_cmd check; exit 0; }
  conf_fallback
  check_conf "$CONF"
}

parse_u() { # sets REF from -u/--username
  REF=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -u|--username) REF="${2:-}"; shift 2 ;;
      -h|--help) usage_cmd "$CMD"; exit 0 ;;
      *) die "unknown option: $1 (see: ohermes $CMD --help)" ;;
    esac
  done
  [[ -n "$REF" ]] || die "missing -u <server name or email> (see: ohermes $CMD --help)"
}

# ---------------------------------------------------------------- help
usage() {
  cat <<EOF
${B}ohermes${N} — manage Hermes Open Enterprise employees

${B}Usage${N}
  ohermes create   -e <email> -s <subdomain> [-p <password>] [-d <department>] [-t <title>]
  ohermes update   -u <user> [-d <department>] [-t <title>] [-e <email>] [-s <subdomain>]
  ohermes rm       -u <user>
  ohermes restore  -u <user>
  ohermes repasswd -u <user>
  ohermes ls
  ohermes check
  ohermes reconf   [--dry-run]
  ohermes model    -u <user> [--show | --reset]
  ohermes sync
  ohermes <command> --help

${B}Commands${N}
  create     add an employee and start their Hermes (asks for the password if -p is omitted)
  update     move to another department, change title, email or subdomain (restarts only them)
  rm         stop an employee's container and move their data to Archive/ (nothing is deleted)
  restore    bring an archived employee back with all their memory and data
  repasswd   set a new dashboard password (signs out existing sessions)
  ls         list employees with email, subdomain, department, title, status, Organization-Knowledge folders and URL
  check      validate Config/ohermes.conf (website rules, [organization-knowledge])
  reconf     apply Config/ohermes.conf to the egress proxy (no restart of any agent)
  model      give one employee a personal AI model + key (Hermes' own picker), show or reset it
  sync       rebuild docker-compose.override.yml (the employee list) from Users/ — run after a deploy

<user> = server name (john-doe) or email (john.doe@example.com).
Organization-Knowledge folders: create/update/rm/restore create, move and archive them unless
Config/ohermes.conf sets [organization-knowledge] manage_folders = off (knowledge kept in its own
repository) — then ohermes never touches Organization-Knowledge and warns which folders are missing.
Server name = email local part, lowercase, other characters → '-'  (John.Doe@… → john-doe); never changes.
On Linux run with sudo.
EOF
}

usage_cmd() {
  case "$1" in
    create) cat <<EOF
ohermes create -e <email> -s <subdomain> [-p <password>] [-d <department>] [-t <title>]

  -e, --email        required, e.g. john.doe@example.com → server name john-doe
                     (Users/john-doe, Organization-Knowledge/Organization/Department/<Dept>/john-doe)
  -s, --subdomain    required, e.g. john → john.<HERMES_DOMAIN>  (a-z 0-9 -, 1-63)
  -p, --password     optional — if omitted you are asked (shown as *). Min 12 characters.
                     A password typed on the command line stays in your shell history.
  -d, --department   optional, e.g. sales → Sales (matches an existing department in any case);
                     omitted → General
  -t, --title        optional, e.g. "Sales Manager"

Server name, email and subdomain must be unused (Users/ and Archive/).
Creates Department/<Dept>/Assign/{Skills,KPI,Knowledge} and Department/<Dept>/<name>/{Skills,KPI,Knowledge}
in Organization-Knowledge — with [organization-knowledge] manage_folders = off (Config/ohermes.conf) it
creates nothing there and lists the missing folders to add to the knowledge repository instead.
The AI model and key come from the root .env (AI_PROVIDER, AI_MODEL, AI_API_KEY);
a personal one is set afterwards with: ohermes model -u <user>
EOF
    ;;
    update) cat <<EOF
ohermes update -u <user> [-d <department>] [-t <title>] [-e <email>] [-s <subdomain>]

  -d   move to another department (their personal folder moves with them; with
       manage_folders = off it is not moved — ohermes prints the old → new path to move yourself)
  -t   new title ("" clears it)
  -e   new email (the server name stays the same) — update Cloudflare Access too
  -s   new subdomain — the old link stops working; update Cloudflare Access/DNS
Only this employee's container is restarted.
EOF
    ;;
    rm) echo "ohermes rm -u <user>    stop the container, move Users/<name> and their personal folder to Archive/<name>_<date> (asks Y/n)"
        echo "                        manage_folders = off: the personal folder stays in Organization-Knowledge";;
    restore) echo "ohermes restore -u <user>    move Archive/<name>_<date> back (personal folder to its department) and start it (asks Y/n)"
        echo "                             manage_folders = off: nothing is moved into Organization-Knowledge (missing folders are listed)";;
    repasswd) echo "ohermes repasswd -u <user>    set a new password (asked, shown as *); signs out existing sessions";;
    ls) echo "ohermes ls    list active, stopped and archived employees, their AI model (central/personal) and ORG = ok|missing (Organization-Knowledge folders)";;
    sync) echo "ohermes sync    rebuild docker-compose.override.yml from Users/ and create missing runtime files (nothing is restarted; never touches Organization-Knowledge with manage_folders = off)";;
    model) cat <<EOF
ohermes model -u <user> [--show | --reset]      (admins, on the server)

  (no option)  run Hermes' own interactive 'hermes model' in a temporary container (never the
               employee's live Hermes), then save the chosen model + API key for this employee only
               in Users/<name>/model/ (mode 600, not visible to the agent) and restart only them.
               Personal settings win over the central AI_* settings of the root .env.
  --show       show the model in use and where it comes from (key masked: last 4 characters)
  --reset      remove the personal model → back to the central one (restarts only them)
Only providers that use an API key are supported. The agent can never change its model.
EOF
    ;;
    check) echo "ohermes check    validate Config/ohermes.conf ([web…] rules, [organization-knowledge] manage_folders = on|off) and report bad lines (nothing is changed)";;
    reconf) cat <<EOF
ohermes reconf [--dry-run]

Apply Config/ohermes.conf to the egress proxy: check → generate Infrastructure/egress/generated/rules.conf
→ squid -k parse → swap → squid -k reconfigure. No agent is restarted.
Any error keeps the previous rules active and exits non-zero.
create, update, rm and restore run it automatically.

  -n, --dry-run   print the generated Squid rules, change nothing
EOF
    ;;
    *) usage;;
  esac
}

# ---------------------------------------------------------------- main
CMD="${1:-}"; shift || true
case "$CMD" in
  create)   cmd_create "$@" ;;
  update)   cmd_update "$@" ;;
  rm)       cmd_rm "$@" ;;
  restore)  cmd_restore "$@" ;;
  repasswd) cmd_repasswd "$@" ;;
  ls)       cmd_ls "$@" ;;
  check)    cmd_check "$@" ;;
  reconf)   cmd_reconf "$@" ;;
  model)    cmd_model "$@" ;;
  sync)     cmd_sync "$@" ;;
  -h|--help|help|"") usage ;;
  *) usage >&2; die "unknown command: $CMD" ;;
esac
