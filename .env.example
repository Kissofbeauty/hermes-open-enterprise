# =====================================================================
# Hermes Open Enterprise — system settings
#   cp .env.example .env      (.env is never committed)
# Per-employee settings live in Users/<name>/.env (created by `ohermes create`).
# =====================================================================

# ---- Stage ----------------------------------------------------------
# dev  : local test, no Cloudflare needed  → http://<subdomain>.localhost:8080
# prod : only requests coming through Cloudflare Access are accepted
STAGE=dev

# Profiles to start. prod: tunnel   (runs cloudflared)
COMPOSE_PROFILES=

# ---- Addresses ------------------------------------------------------
# Each employee gets <PUBLIC_SCHEME>://<subdomain>.<HERMES_DOMAIN><PUBLIC_PORT_SUFFIX>  (ohermes create -s)
#   dev : http://john-doe.localhost:8080
#   prod: https://john-doe.hermes.example.com
HERMES_DOMAIN=localhost
PUBLIC_SCHEME=http
PUBLIC_PORT_SUFFIX=:8080

# Where Caddy listens on this machine. Keep 127.0.0.1 — prod traffic comes through the tunnel.
CADDY_BIND=127.0.0.1
CADDY_PORT=8080

# ---- Cloudflare Tunnel (prod) ----------------------------------------
# Tunnel public hostname:  *.<HERMES_DOMAIN>  →  http://caddy:80
CLOUDFLARE_TUNNEL_TOKEN=
# Shared secret Cloudflare adds to every request (Transform Rule → set request header
# X-Hermes-Origin: <this value>). Required when STAGE=prod, min 32 characters.
# Generate: openssl rand -hex 32
ORIGIN_SECRET=

# ---- Images: exact version + digest (tag@sha256:…) ------------------
# Update = change the line after testing the new version on the dev stage, then: docker compose up -d
HERMES_IMAGE=nousresearch/hermes-agent:v0.22.2@sha256:36099926da316742423544e055d4734777105ffe6341873af5459b957d0c2919
CADDY_IMAGE=caddy:2.10.2-alpine@sha256:4c6e91c6ed0e2fa03efd5b44747b625fec79bc9cd06ac5235a779726618e530d
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.10.2@sha256:0e56c13c7058fcef9c4f0e7d83372f82330548dbf8f8b366f3d8b506526d93b2
EGRESS_IMAGE=ubuntu/squid:6.6-24.04_edge@sha256:8a3baed477e2c282ab8aa5edad442f69873246964f225c5c2ae8364b6610963c

# ---- AI model (central — everyone, unless `ohermes model -u <name>` set a personal one) ----
# AI_PROVIDER: a Hermes provider id — the same list `hermes model` shows (Hermes v0.22.2).
#              Only this provider is usable: every other one is disabled for `/model` in chats.
#              Supported here (API key):
#                openrouter        OpenRouter — pay-per-use aggregator
#                anthropic         Anthropic (Claude)
#                openai-api        OpenAI API (api.openai.com)
#                gemini            Google AI Studio (Gemini)
#                deepseek          DeepSeek
#                xai               xAI Grok (direct API)
#                fireworks         Fireworks AI
#                novita            NovitaAI
#                alibaba           Qwen Cloud / DashScope
#                xiaomi            Xiaomi MiMo
#                tencent-tokenhub  Tencent TokenHub
#                tencent-tokenplan Tencent TokenPlan
#                nvidia            NVIDIA NIM (build.nvidia.com)
#                huggingface       Hugging Face Inference Providers
#                zai               Z.AI / GLM (Zhipu)
#                kimi-coding       Kimi / Moonshot
#                kimi-coding-cn    Kimi / Moonshot (China)
#                stepfun           StepFun Step Plan
#                minimax           MiniMax
#                minimax-cn        MiniMax (China)
#                ollama-cloud      Ollama Cloud
#                arcee             Arcee AI
#                gmi               GMI Cloud
#                kilocode          Kilo Code
#                opencode-zen      OpenCode Zen
#                opencode-go       OpenCode Go
#                azure-foundry     Azure Foundry (also set AI_BASE_URL to your deployment)
#                ai-gateway        Vercel AI Gateway
#                custom            any OpenAI-compatible endpoint (AI_BASE_URL required)
#              Not supported here (sign-in / cloud credentials / local app — no single API key):
#                nous · openai-codex · xai-oauth · minimax-oauth · qwen-oauth · copilot ·
#                copilot-acp · vertex · bedrock · lmstudio · moa
#              To see each provider's model ids: run `hermes model` in any Hermes container.
# AI_MODEL   : the provider's model id exactly as `hermes model` lists it
#              (openrouter ids look like <vendor>/<model>; direct providers use their own ids)
# AI_API_KEY : ONE key for the whole organization, straight from the provider you chose
#              (no aggregator needed) — set a spending limit in that provider's console.
# AI_BASE_URL: leave empty for the providers above; only `custom` and `azure-foundry` need it.
#              After a change: docker compose up -d   (recreates every Hermes with the new values)
#
# Examples — uncomment ONE block (or fill in the empty lines below):
#   Anthropic (Claude), key from console.anthropic.com
#     AI_PROVIDER=anthropic
#     AI_MODEL=claude-sonnet-5-5
#     AI_API_KEY=sk-ant-...
#   OpenAI, key from platform.openai.com
#     AI_PROVIDER=openai-api
#     AI_MODEL=<model id from `hermes model`>
#     AI_API_KEY=sk-...
#   Google Gemini, key from aistudio.google.com
#     AI_PROVIDER=gemini
#     AI_MODEL=<model id from `hermes model`>
#     AI_API_KEY=...
#   OpenRouter (one key, many vendors), key from openrouter.ai
#     AI_PROVIDER=openrouter
#     AI_MODEL=<vendor>/<model>
#     AI_API_KEY=sk-or-...
#   Self-hosted / any OpenAI-compatible server
#     AI_PROVIDER=custom
#     AI_MODEL=<model name on that server>
#     AI_BASE_URL=https://llm.example.com/v1
#     AI_API_KEY=...
AI_PROVIDER=
AI_MODEL=
AI_BASE_URL=
AI_API_KEY=
# Website(s) of the AI provider — ALWAYS allowed by the egress proxy. Empty → derived from
# AI_PROVIDER / AI_BASE_URL (openrouter → openrouter.ai, anthropic → api.anthropic.com, …).
AI_PROVIDER_HOSTS=

# ---- Defaults for new employees (ohermes create) ---------------------
DEFAULT_CPUS=2
DEFAULT_MEMORY=4g
# First two octets of the per-employee /28 networks
NETWORK_PREFIX=10.213

# ---- Logs -----------------------------------------------------------
LOG_RETENTION_DAYS=30        # caddy + docker logs older than this...
LOG_ARCHIVE_ACTION=move      # ...are moved to Logs/archive (or: delete)
LOG_ARCHIVE_KEEP_DAYS=365    # archive is purged after this (0 = keep forever)

# ---- Backups --------------------------------------------------------
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
# Strongly recommended: encrypt backups with an age public key (age1...).
# Keep the private key OFF this server.
BACKUP_AGE_RECIPIENT=

TZ=Asia/Bangkok
