# ---- Secrets: never commit ----
.env
**/.env
!.env.example

# ---- Employees ----
# Public template: only the template folder is tracked.
# In your PRIVATE copy you may track employee folders by removing the next two lines —
# their .env and data/ stay ignored by the rules below.
Users/*
!Users/_template/
Users/*/data/
Users/*/.env
Users/*/secrets.env
# generated at every container start (locked Hermes settings + AI key) / personal AI model + key
Users/*/runtime/
Users/*/model/
# Personal folders (Skills/KPI/Knowledge) of employees, and departments other than General.
# In your PRIVATE copy remove these lines too, to track department and personal content.
Organization-Knowledge/Organization/Department/*
!Organization-Knowledge/Organization/Department/General/
Organization-Knowledge/Organization/Department/General/*
!Organization-Knowledge/Organization/Department/General/Assign/

# ---- Runtime data ----
# the employee list for Docker Compose — generated by ohermes on the server
docker-compose.override.yml
Infrastructure/egress/generated/*
!Infrastructure/egress/generated/.gitkeep
# Caddy routes of the active employees — generated by ohermes from Users/*/.env
Infrastructure/caddy/generated/*
!Infrastructure/caddy/generated/.gitkeep
Archive/*
Logs/*
Backups/*
dev-data/
!Archive/.gitkeep
!Logs/.gitkeep
!Backups/.gitkeep

.DS_Store
Thumbs.db
.vscode/
.idea/

# ---- Maintainers' private notes (QA reports, security reviews) — never published ----
docs/

# ---- Python build artefacts ----
__pycache__/
*.py[cod]

# ohermes: "do not offer to install the ohermes command again" (see ohermes install --help)
.ohermes-no-install
